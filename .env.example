# ============================================================================
# Scriptica — environment variables
# ============================================================================
# IMPORTANT CONTEXT: the app itself reads NO environment variables. It is a
# static HTML/CSS/JS site with no build step; nothing in js/ loads a .env file.
# The variables below exist ONLY for deploying to Cloudflare Pages, and even
# then they are OPTIONAL — the default auth path is interactive OAuth via
# `npx wrangler login` (no env vars at all).
#
# If you do create a real `.env` from this template, it is gitignored
# (see .gitignore). NEVER commit real values.
# ============================================================================

# ----------------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN
# Purpose:       lets `npx wrangler pages deploy` authenticate non-interactively,
#                as an alternative to the OAuth login (which expires ~monthly).
# Required locally: NO for running/developing the app; only if you want
#                non-interactive deploys.
# Where to get:  Cloudflare dashboard -> My Profile -> API Tokens ->
#                Create Token -> use the "Cloudflare Pages — Edit" permission,
#                scoped to the single account (least privilege).
# Secret:        YES — never commit, never paste into files or chat.
# Dev/prod split: not applicable (there is only one Cloudflare project;
#                one token is enough).
CLOUDFLARE_API_TOKEN=paste-your-token-here-do-not-commit

# ----------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID
# Purpose:       disambiguates which Cloudflare account wrangler targets.
#                Usually unnecessary (the OAuth/cached config already knows),
#                but required alongside CLOUDFLARE_API_TOKEN in fresh CI-like
#                environments.
# Required locally: NO.
# Where to get:  Cloudflare dashboard -> the account home URL contains it,
#                or run `npx wrangler whoami`. (For this project it is the
#                account named "Andrus.vlad@gmail.com's Account".)
# Secret:        NO — it is an identifier, not a credential. Still kept as a
#                placeholder here for consistency.
# Dev/prod split: not applicable.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
